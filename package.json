{
  "name": "template-vitejs-vue3-tailwindcss-fontawesome",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare-env": "npx tsx ./prepare-env.ts && echo '//DON T EDIT THIS FILE IT IS A COPY OF src/auth0/TokenHelper.ts' > api/common/auth0/TokenHelper.ts && cat src/auth0/TokenHelper.ts >> api/common/auth0/TokenHelper.ts",
    "_preinstall": "cd api && npm install && npm run prepare-env",
    "dev": "npm run prepare-env && vite",
    "convert-typo": "npx tsx ./typo/generate-webfonts.ts",
    "build": "npm run convert-typo && npm run prepare-env && vite build && gulp licenses",
    "preview": "vite preview",
    "start": "npx @azure/static-web-apps-cli start https://localhost:5173 --swa-config-location ./ -s -e localhost.pem -k localhost.key -p 8788 --api-location ./api -t 120 --run 'npm run dev'",
    "prestart": "cd api && npm run watch &",
    "create-cert": "openssl req -x509 -newkey rsa:4096 -keyout localhost.key -out localhost.pem -sha256 -nodes -days 365"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.20.0",
    "@azure/cosmos": "^4.9.3",
    "@azure/functions": "^4.16.0",
    "@pqina/flip": "^1.8.4",
    "@vueuse/core": "^14.3.0",
    "jose": "^6.2.3",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "vue": "3.5.34",
    "vue-i18n": "^11.4.4",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "2.0.9",
    "@babel/types": "^7.29.0",
    "@highcanfly-club/fontawesome": "^1.2.0",
    "@sctg/code-stats": "^0.1.4",
    "@sctg/fontminify": "^1.0.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/glob": "^8.1.0",
    "@types/gulp": "^4.0.18",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "autoprefixer": "^10.5.0",
    "glob": "13.0.6",
    "gulp": "^5.0.1",
    "gulp-append-prepend": "^1.0.9",
    "gulp-replace": "^1.1.4",
    "npm-check-updates": "^22.2.0",
    "postcss": "^8.5.15",
    "postcss-purgefonts": "^1.0.2",
    "sass": "^1.100.0",
    "tailwindcss": "^4.3.0",
    "ts-node": "^10.9.2",
    "tsx": "4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  }
}
